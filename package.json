{
  "name": "nuxt-prepare",
  "type": "module",
  "version": "4.0.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Run async code at build time, before Nuxt finalizes its config",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://nuxt-prepare.byjohann.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/nuxt-prepare.git"
  },
  "bugs": "https://github.com/johannschopplich/nuxt-prepare/issues",
  "keywords": [
    "init",
    "nuxt",
    "prepare",
    "server"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "docs:build": "pnpm --filter docs run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:preview": "pnpm --filter docs run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "nuxt-module-build build",
    "release": "bumpp",
    "test": "vitest",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7",
    "jiti": "^2.7.0",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.0"
  }
}
